# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=CHANGEME

# Guild ID to instantly sync slash commands to during development.
# Leave blank in production (commands sync globally, ~1hr propagation).
DEV_GUILD_ID=

# Comma-separated user IDs allowed to use /dev commands.
OWNER_IDS=1313630076809510975

# Where the SQLite database file lives.
DATABASE_PATH=data/replay.db

# Whether solo VC sessions (nobody else in the channel) count toward
# voice time by default. Per-server override lives in guild_settings.
EXCLUDE_SOLO_VC=true

LOG_LEVEL=INFO
